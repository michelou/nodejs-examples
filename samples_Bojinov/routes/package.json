{
  "name": "routes-app",
  "version": "0.0.1",
  "description": "2015_Packt_RESTful_Web_API_Design_with Node.js, p.44",
  "main": "app/app.js",
  "maintainers": [
    {
      "name": "Stéphane Micheloud",
      "web": "http://lampwww.epfl.ch/~michelou/"
    }
  ],
  "private": true,
  "scripts": {
    "clean": "node ./npm_scripts/clean.js",
    "lint": "eslint app && eslint --env mocha test",
    "reinstall": "npm run clean && npm install -audit",
    "start": "node ./npm_scripts/start_browser.js && node .",
    "test": "mocha --recursive"
  },
  "dependencies-npmjs": {
    "body-parser": "https://www.npmjs.com/package/body-parser",
    "express": "https://www.npmjs.com/package/express",
    "start": {
      "url": "https://www.npmjs.com/package/start",
      "comment": "Deprecated in favor of https://github.com/deepsweet/start"
    }
  },
  "dependencies": {
    "body-parser": "^2.3.0",
    "express": "^5.2.1",
    "start": "^5.1.0"
  },
  "devDependencies-npmjs": {
    "chai": "https://www.npmjs.com/package/chai",
    "eslint": "https://www.npmjs.com/package/eslint",
    "eslint-plugin-import": {
      "url": "https://www.npmjs.com/package/eslint-plugin-import",
      "comment": "peer eslint@\"^2 || ^3 || ^4 || ^5 || ^6 || ^7.2.0 || ^8 || ^9\" from eslint-plugin-import@2.32.0"
    },
    "eslint-plugin-node": "https://www.npmjs.com/package/eslint-plugin-node",
    "eslint-plugin-promise": "https://www.npmjs.com/package/eslint-plugin-promise",
    "minimatch": "https://www.npmjs.com/package/minimatch",
    "mocha": "https://www.npmjs.com/package/mocha",
    "superagent": "https://www.npmjs.com/package/superagent"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "eslint": "^9.39.4",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.1.0",
    "mocha": "^11.3.0",
    "superagent": "^10.3.0"
  },
  "engines": {
    "node": ">=16.20.2",
    "npm": ">=6.14.0"
  }
}
