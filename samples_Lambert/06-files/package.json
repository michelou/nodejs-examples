{
  "name": "files",
  "version": "0.0.1",
  "description": "NodeJS – Exploitez la puissance de JavaScript côté serveur (ENI, 2015)",
  "repository": "https://github.com/vatesfr/eni-nodejs.git",
  "author": "Olivier Lambert",
  "private": true,
  "scripts": {
    "clean": "node ./npm_scripts/clean.js",
    "dirs": "node app/directories.js",
    "files": "node app/files.js",
    "lint": "eslint app",
    "paths": "node app/paths.js",
    "reinstall": "npm run clean && npm install -audit",
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch": "node app/watch.js"
  },
  "dependencies-npmjs": {
    "absolute-path": "https://www.npmjs.com/package/absolute-path",
    "chokidar": "https://www.npmjs.com/package/chokidar",
    "mkdirp": "https://www.npmjs.com/package/mkdirp",
    "rimraf": "https://www.npmjs.com/package/rimraf" 
  },
  "dependencies": {
    "absolute-path": "0.0.0",
    "chokidar": "^5.0.0",
    "mkdirp": "^3.0.1",
    "rimraf": "^6.1.3"
  },
    "devDependencies-npmjs": {
    "eslint": "https://www.npmjs.com/package/eslint",
    "eslint-plugin-import": {
      "url": "https://www.npmjs.com/package/eslint-plugin-import",
      "comment": "peer eslint@\"^2 || ^3 || ^4 || ^5 || ^6 || ^7.2.0 || ^8 || ^9\" from eslint-plugin-import@2.32.0"
    },
    "eslint-plugin-node": "https://www.npmjs.com/package/eslint-plugin-node",
    "eslint-plugin-promise": "https://www.npmjs.com/package/eslint-plugin-promise"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.0.0"
  },
  "engines": {
    "node": ">=16.20.0",
    "npm": ">=6.14.0"
  }
}
